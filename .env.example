# Copy to .env (gitignored). Only ANTHROPIC_API_KEY matters for Sleeper leagues;
# the ESPN values are for the legacy in-season waiver tools.
ANTHROPIC_API_KEY=sk-ant-...

# ESPN league only (optional)
LEAGUE_ID=
YEAR=2026
ESPN_S2=""
SWID="{...}"
MY_TEAM_NAME=

# FantasyPros consensus projections (HOF / Premium API tier). Optional: without
# it the board is Sleeper-only.
FANTASYPROS_API_KEY=

# Claude models. FAST handles news lookups (cheap, frequent), ANALYST answers
# draft questions with the board in context. Optional; these are the defaults.
CLAUDE_FAST_MODEL=claude-haiku-4-5
CLAUDE_ANALYST_MODEL=claude-sonnet-4-6
