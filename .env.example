# Copy to .env (gitignored). ANTHROPIC_API_KEY powers news and the analyst.
ANTHROPIC_API_KEY=sk-ant-...

# FantasyPros consensus projections (HOF / Premium API tier). Optional: without
# it the board is Sleeper-only.
FANTASYPROS_API_KEY=

# Claude models and effort. FAST handles news lookups, ANALYST answers draft
# questions with the board in context. Optional; these are the defaults.
# Effort: low | medium | high | xhigh | max (current-generation models only).
CLAUDE_FAST_MODEL=claude-opus-5
CLAUDE_FAST_EFFORT=low
CLAUDE_ANALYST_MODEL=claude-opus-5
CLAUDE_ANALYST_EFFORT=high
# Web searches the analyst may run per question. 0 (default) answers from the
# board in ~18s; 2 adds breaking news but takes 40-120s. Keep 0 on draft day.
CLAUDE_ANALYST_SEARCH_USES=0
